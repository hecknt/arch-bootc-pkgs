-        assert_eq!(
-            file_id(&f),
-            etc_id,
-            "empty env var should fall through to /etc"
-        );
-
-        // XDG_CONFIG_HOME wins when file exists
-        let xdg_id = touch(&td, "xdg/containers/policy.json");
-        let f = resolve_policy_path(&td, None, Some(Path::new("/xdg")), None)?;
