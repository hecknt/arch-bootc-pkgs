# Maintainer: Hec <hec@heccraft.com>
pkgname=bootc
pkgver=1.17.1 # renovate: datasource=github-releases depName=bootc-dev/bootc
pkgrel=1
pkgdesc="Boot and upgrade via container images"
arch=('x86_64' 'aarch64')
url="https://github.com/bootc-dev/$pkgname"
license=('MIT OR Apache-2.0')
depends=(bash
  gcc-libs
  glib2
  glibc
  openssl
  ostree
  skopeo
  zlib
  zstd)
makedepends=(cargo
  go-md2man
  git)
source=("git+$url.git#tag=v$pkgver")
sha256sums=('03a9c86708f6526fe8fae2f5cd2fa6db534753b638f56b6f327a306116976e0a')

# Arch Linux doesn't have libselinux, so we need to explicitly disable its usage in bootc's build
_cargo_options=(--no-default-features --features install-to-disk)

prepare() {
  cd "$pkgname"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export CARGO_TARGET_DIR=target
  make bin CARGO_OPTIONS="${_cargo_options[*]}"
}

check() {
  export RUST_BACKTRACE=1
  cd $pkgname
  cargo test --frozen ${_cargo_options[*]}
}

package() {
  cd "$pkgname"
  ./target/release/bootc completion bash > bootc.bash
  ./target/release/bootc completion zsh > bootc.zsh
  ./target/release/bootc completion fish > bootc.fish
  ./target/release/bootc completion elvish > bootc.elv
  install -Dm0644 bootc.bash "$pkgdir/usr/share/bash-completion/completions/bootc"
  install -Dm0644 bootc.zsh "$pkgdir/usr/share/zsh/site-functions/_bootc"
  install -Dm0644 bootc.fish "$pkgdir/usr/share/fish/vendor_completions.d/bootc.fish"
  install -Dm0644 bootc.elv "$pkgdir/usr/share/elvish/lib/bootc.elv"

  install -Dm644 "LICENSE-APACHE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
  install -Dm644 "LICENSE-MIT" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  make DESTDIR="$pkgdir/" install-all CARGO_OPTIONS="${_cargo_options[*]}"
}
